{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "azure-devops": {
      "command": "/Users/your-user/.nvm/versions/node/v20.19.0/bin/npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "YOUR_ORGANIZATION"
      ],
      "env": {
        "PATH": "/Users/your-user/.nvm/versions/node/v20.19.0/bin:/usr/local/bin:/usr/bin:/bin",
        "AZURE_DEVOPS_AUTH_METHOD": "pat",
        "AZURE_DEVOPS_PAT": "${env:AZURE_DEVOPS_PAT}",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "YOUR_PROJECT"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}