<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.bintec</groupId>
	<artifactId>BCO.WKS.901.EAR</artifactId>
	<version>1.0.0</version>
	<packaging>ear</packaging>
	<name>BCO.WKS.901.EAR</name>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>2.17.2</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.bintec</groupId>
			<artifactId>BCO.WKS.901.SEF</artifactId>
			<version>1.0.0</version>
			<type>war</type>
		</dependency>
		<dependency>
			<groupId>org.bintec</groupId>
			<artifactId>BCO.WKS.901.SEC</artifactId>
			<version>1.0.0</version>
			<type>ejb</type>
		</dependency>
	</dependencies>
	<build>
		<finalName>BCO.WorkshopServices.901</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<version>7</version>
					<applicationName>BCO.WorkshopServices.901</applicationName>
					<displayName>BCO.WorkshopServices.901</displayName>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
					<modules>
						<webModule>
							<groupId>org.bintec</groupId>
							<artifactId>BCO.WKS.901.SEF</artifactId>
							<bundleFileName>BCO.WKS.901.SEF.war</bundleFileName>
							<contextRoot>/BCO.WKS.901.SEF</contextRoot>
						</webModule>
						<ejbModule>
							<groupId>org.bintec</groupId>
							<artifactId>BCO.WKS.901.SEC</artifactId>
							<bundleFileName>BCO.WKS.901.SEC.jar</bundleFileName>
						</ejbModule>
					</modules>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<repositories>
		<repository>
			<id>workshop-libs</id>
			<name>workshop-libs</name>
			<url>file://${project.basedir}/../../libs/repository</url>
		</repository>
	</repositories>
</project>
