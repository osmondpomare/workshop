<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
	<persistence-unit name="JPAManager" transaction-type="JTA">
		<jta-data-source>jdbc/WorkshopDS</jta-data-source>
		<class>org.bintec.bco.wks901.jpa.model.Reverso</class>
		<class>org.bintec.bco.wks901.jpa.model.Parametro</class>
		<exclude-unlisted-classes>true</exclude-unlisted-classes>
		<shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>
		<properties>
			<property name="eclipselink.logging.level" value="WARNING"/>
		</properties>
	</persistence-unit>
</persistence>
